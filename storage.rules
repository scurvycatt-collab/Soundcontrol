rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isStaff() {
      return request.auth != null && request.auth.token.role in ['admin', 'operator'];
    }

    match /sounds/{soundId}/{fileName} {
      allow read: if isStaff();

      // Tạo mới: chỉ admin, <= 100 MiB, MP3/WAV, tên file là UUID (không dùng tên người dùng).
      allow create: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType in ['audio/mpeg', 'audio/wav']
        && fileName.matches('[0-9a-f-]{36}\\.(mp3|wav)');

      // Không cho ghi đè nội dung đã có.
      allow update: if false;

      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
