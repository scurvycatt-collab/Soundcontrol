{
  "name": "stage-audio-control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web app điều khiển nhạc nền (BGM) và hiệu ứng (SFX) cho sân khấu kịch",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-stage-audio \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-stage-audio",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy": "npm run build && firebase deploy",
    "set-role": "node scripts/set-user-role.mjs",
    "e2e": "node scripts/e2e-real-howler.mjs",
    "build:demo": "vite build --mode demo --outDir release/stage-audio-demo/app --emptyOutDir",
    "demo": "npm run build:demo && node release/stage-audio-demo/serve.mjs",
    "e2e:demo": "node scripts/e2e-demo.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "howler": "^2.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
