# Firebase WEB config (không phải bí mật server; bảo vệ dữ liệu bằng Security Rules).
# Lấy ở: Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Đặt true để chạy với Firebase Emulator (dev cục bộ). Khi dùng emulator, đặt
# VITE_FIREBASE_PROJECT_ID=demo-stage-audio và các giá trị khác là placeholder bất kỳ.
VITE_USE_EMULATORS=false

# TUYỆT ĐỐI KHÔNG đặt service account / private key trong file này (mọi biến VITE_* bị đóng gói vào bundle).
